{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octgn-multi-game-feed",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "r2_buckets": [
    {
      "binding": "OCTGN_DATA",
      "bucket_name": "octgn-game-data"
    }
  ]
}
